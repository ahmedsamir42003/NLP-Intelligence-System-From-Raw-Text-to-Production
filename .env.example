# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=nlp_text_vectorization

# DVC Configuration
DVC_REMOTE_URL=s3://your-bucket/dvc-storage
DVC_REMOTE_NAME=myremote

# Dataset Configuration
AMAZON_REVIEWS_URL=https://snap.stanford.edu/data/finefoods.txt.gz
SENTIMENT140_URL=http://help.sentiment140.appspot.com/files/training.1600000.processed.noemoticon.csv

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_WORKERS=4

# Model Configuration
EMBEDDING_MODEL=word2vec  # or glove, fasttext, word2vec
EMBEDDING_DIM=300
MIN_WORD_FREQ=5

# Search Configuration
BM25_K1=1.5
BM25_B=0.75
TOP_K_RESULTS=10

# Data Configuration
TRAIN_TEST_SPLIT=0.8
RANDOM_SEED=42
BATCH_SIZE=32

# Logging
LOG_LEVEL=INFO
